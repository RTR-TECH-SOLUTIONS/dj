---
import { u } from '../lib/url';
import Layout from '../layouts/Layout.astro';
import EquipmentCard from '../components/EquipmentCard.astro';
import Icon from '../components/Icon.astro';
import { equipment, categories } from '../data/equipment';
import { site } from '../data/site';
---

<Layout title={`Echipamente de închiriat: boxe, DJ, lumini | ${site.name}`}>
  <section class="border-b border-line bg-bg-alt">
    <div class="wrap py-12 text-center sm:py-16">
      <h1 class="page-in text-[clamp(2rem,4vw,3rem)] font-bold tracking-tight">Echipamente</h1>
      <p class="page-in mx-auto mt-3 max-w-xl text-muted" style="--d:1">Prețuri pe zi de închiriere, fără TVA. Adaugă echipamentele în coș, alege perioada și trimite cererea de ofertă.</p>
      <label class="page-in relative mx-auto mt-8 block max-w-xl" style="--d:2">
        <span class="sr-only">Caută în catalog</span>
        <Icon name="search" size={18} class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-muted" />
        <input id="search" type="search" class="field h-12 rounded-xl bg-card pl-11" placeholder="Caută echipamente..." autocomplete="off" />
      </label>
    </div>
  </section>

  <section class="wrap py-10">
    <div class="grid gap-8 lg:grid-cols-[240px_1fr]">
      <aside>
        <div class="lg:sticky" style="top:calc(var(--header-h) + 24px)">
          <h2 class="mb-3 hidden text-sm font-bold lg:block">Categorii</h2>
          <div class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 lg:mx-0 lg:flex-col lg:px-0" role="group" aria-label="Filtru categorii">
            <button type="button" data-filter="all" aria-pressed="true" class="cat-btn">
              <span>Toate</span><span class="tnum text-muted">{equipment.length}</span>
            </button>
            {categories.map((c) => (
              <button type="button" data-filter={c.id} aria-pressed="false" class="cat-btn">
                <span class="inline-flex items-center gap-2.5"><Icon name={c.icon} size={16} class="text-primary" />{c.label}</span>
                <span class="tnum text-muted">{equipment.filter((e) => e.category === c.id).length}</span>
              </button>
            ))}
          </div>
          <div class="card mt-6 hidden p-5 lg:block">
            <p class="font-bold">Nu știi ce să alegi?</p>
            <p class="mt-1.5 text-sm text-muted">Alege un pachet după numărul de invitați.</p>
            <a href={u('/#pachete')} class="btn btn-secondary btn-sm mt-4 w-full">Vezi pachetele</a>
          </div>
        </div>
      </aside>

      <div>
        <p id="result-count" class="text-sm text-muted" aria-live="polite"></p>
        <div id="grid" class="mt-4 grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
          {equipment.map((item, i) => <EquipmentCard item={item} eager={i < 3} />)}
        </div>
        <div id="no-results" class="card mt-4 hidden p-10 text-center">
          <p class="font-bold">Nu am găsit nimic pentru căutarea asta.</p>
          <p class="mt-2 text-sm text-muted">Avem și echipamente care nu sunt listate. Scrie-ne pe WhatsApp ce cauți.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-in { animation: pageIn 0.8s cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: calc(var(--d, 0) * 100ms + 60ms); }
  @keyframes pageIn { from { opacity: 0; transform: translateY(14px); } }
  .cat-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 42px;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: var(--color-card);
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
    text-align: left;
    transition: border-color 0.15s ease-out, background-color 0.15s ease-out;
  }
  .cat-btn:hover { border-color: var(--color-line-strong); }
  .cat-btn[aria-pressed='true'] { border-color: var(--color-primary); background: color-mix(in srgb, var(--color-primary) 12%, transparent); }
</style>

<script>
  const cards = [...document.querySelectorAll<HTMLElement>('[data-item]')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const search = document.getElementById('search') as HTMLInputElement;
  const count = document.getElementById('result-count')!;
  const none = document.getElementById('no-results')!;

  const params = new URLSearchParams(location.search);
  let cat = params.get('cat') || 'all';
  search.value = params.get('q') || '';

  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

  function apply() {
    const words = norm(search.value.trim()).split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const c of cards) {
      const hay = norm(c.dataset.name || '');
      const ok = (cat === 'all' || c.dataset.cat === cat) && words.every((w) => hay.includes(w));
      const wasHidden = c.hidden;
      c.hidden = !ok;
      if (ok) {
        if (wasHidden && !matchMedia('(prefers-reduced-motion: reduce)').matches)
          c.animate([{ opacity: 0, transform: 'translateY(14px) scale(0.98)' }, { opacity: 1, transform: 'none' }], { duration: 420, delay: shown * 40, easing: 'cubic-bezier(0.22,1,0.36,1)', fill: 'backwards' });
        shown++;
      }
    }
    chips.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === cat)));
    count.textContent = `${shown} ${shown === 1 ? 'produs' : 'produse'}`;
    none.classList.toggle('hidden', shown > 0);

    const url = new URL(location.href);
    cat === 'all' ? url.searchParams.delete('cat') : url.searchParams.set('cat', cat);
    search.value ? url.searchParams.set('q', search.value) : url.searchParams.delete('q');
    history.replaceState(null, '', url);
  }

  chips.forEach((b) => b.addEventListener('click', () => { cat = b.dataset.filter!; apply(); }));
  search.addEventListener('input', apply);
  apply();
</script>
