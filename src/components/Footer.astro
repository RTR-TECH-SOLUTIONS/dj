---
import { u } from '../lib/url';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { categories } from '../data/equipment';
---

<footer class="border-t border-line bg-bg-alt">
  <div class="wrap grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <Logo />
      <p class="mt-5 max-w-xs text-sm leading-relaxed text-muted">
        Închirieri sonorizare, echipamente DJ și lumini în {site.city}. Livrare, montaj și DJ pentru evenimentul tău.
      </p>
    </div>
    <div>
      <h2 class="font-bold">Utile</h2>
      <ul class="mt-4 space-y-2.5 text-sm text-muted">
        <li><a class="hover:text-ink" href={u('/#pachete')}>Pachete</a></li>
        <li><a class="hover:text-ink" href={u('/evenimente')}>Evenimente DJ</a></li>
        <li><a class="hover:text-ink" href={u('/#cum-inchiriezi')}>Cum închiriezi</a></li>
        <li><a class="hover:text-ink" href={u('/#contact')}>Contact</a></li>
      </ul>
    </div>
    <div>
      <h2 class="font-bold">Categorii</h2>
      <ul class="mt-4 space-y-2.5 text-sm text-muted">
        {categories.map((c) => <li><a class="hover:text-ink" href={u(`/echipamente?cat=${c.id}`)}>{c.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="font-bold">Contact</h2>
      <ul class="mt-4 space-y-3 text-sm text-muted">
        <li class="flex gap-2.5"><Icon name="pin" size={17} class="mt-0.5 shrink-0 text-accent" />{site.address}</li>
        <li class="flex gap-2.5"><Icon name="phone" size={17} class="mt-0.5 shrink-0 text-accent" /><a class="hover:text-ink" href={site.phoneHref}>{site.phone}</a></li>
        <li class="flex gap-2.5"><Icon name="mail" size={17} class="mt-0.5 shrink-0 text-accent" /><a class="hover:text-ink" href={`mailto:${site.email}`}>{site.email}</a></li>
        <li class="flex gap-2.5"><Icon name="clock" size={17} class="mt-0.5 shrink-0 text-accent" />Lun–Vin 10–19 · Sâm 10–14</li>
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-col gap-2 border-t border-line py-6 text-sm text-muted sm:flex-row sm:justify-between">
    <p>© 2026 {site.legalName}. Toate drepturile rezervate.</p>
    <p>Demo de prezentare · conținut provizoriu</p>
  </div>
</footer>
